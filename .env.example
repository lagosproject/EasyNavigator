# ==============================================================================
# Easy Navigator Environment Configuration Example
# Copy this file to .env and configure your environment variables.
# ==============================================================================

# Google Play Developer API Service Account (for store automation & uploads)
PLAY_STORE_JSON_KEY=/path/to/google-play-service-account.json

# Release Keystore Signing Credentials (Optional alternative to keystore.properties)
KEYSTORE_PATH=/path/to/release.keystore
KEYSTORE_PASSWORD=your_keystore_password
KEY_ALIAS=your_key_alias
KEY_PASSWORD=your_key_password
